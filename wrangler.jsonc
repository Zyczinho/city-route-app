{
  "name": "city-route-app",
  "compatibility_date": "2026-11-02",
  // worker.js answers /api/events; every other request is a static file from dist/.
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Preview settings are isolated from production; secret values must NEVER be committed.
  // These are low, per-isolate soft caps only. A provider-side hard quota is required
  // before enabling paid Google Places calls. Start fail-closed.
  "previews": {
    "vars": {
      "GOOGLE_PLACES_BETA_ENABLED": "off",
      "GOOGLE_PLACES_DAILY_CAP": "5",
      "GOOGLE_THUMBS_DAILY_CAP": "5",
      "GOOGLE_PLACES_AUTOCOMPLETE": "off",
      "GOOGLE_PLACES_INCLUDE_REVIEWS": "off",
      "TRIPADVISOR_CONTENT_BETA_ENABLED": "off",
      "TRIPADVISOR_CONTENT_INCLUDE_REVIEWS": "off",
      "TRIPADVISOR_TERRA_INCLUDE_REVIEWS": "off"
    }
  },
  "workers_dev": true
}
